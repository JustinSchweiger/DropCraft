# Caddy holt automatisch ein HTTPS-Zertifikat von Let's Encrypt.
# DROPCRAFT_ALIASES: weitere Adressen (z. B. die alte), durch Leerzeichen getrennt.
{$DROPCRAFT_DOMAIN} {$DROPCRAFT_ALIASES} {
	reverse_proxy dropcraft:8080 {
		# Große Uploads nicht puffern, direkt durchreichen.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# n8n (eigene Subdomain, DNS-A-Eintrag auf den Server nötig)
{$N8N_DOMAIN:n8n.dropcraft.tech} {
	reverse_proxy n8n:5678
	header -Server
}
